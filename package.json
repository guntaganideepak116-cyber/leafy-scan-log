{
  "name": "smartplant-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Plant AI - Disease Detection System",
  "type": "module",
  "scripts": {
    "build": "npm --prefix backend run build && npm --prefix frontend run build",

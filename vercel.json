{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "smartplant-ai",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "tanstack-start"
    },
    "backend": {
      "root": "backend",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "backend",
        "path": "/"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend",
        "path": "/api/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
